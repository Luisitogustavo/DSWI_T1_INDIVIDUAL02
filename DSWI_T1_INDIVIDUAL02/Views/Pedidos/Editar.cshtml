@model DSWI_T1_INDIVIDUAL02.Models.Pedido

@{
    ViewData["Title"] = "Editar pedido";
}

<h2>Editar pedido</h2>

<form asp-action="Editar" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PedidoId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FechaPedido" class="form-label">Fecha del pedido</label>
        <input asp-for="FechaPedido" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Monto" class="form-label">Monto ($)</label>
        <input asp-for="Monto" type="number" step="0.01"
               min="0" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select" required>
            <option value="Pendiente">Pendiente</option>
            <option value="Entregado">Entregado</option>
            <option value="Cancelado">Cancelado</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ClienteId" class="form-label">Cliente</label>
        <select asp-for="ClienteId" asp-items="ViewBag.Clientes"
                class="form-select" required>
            <option value="">Seleccione un cliente</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
