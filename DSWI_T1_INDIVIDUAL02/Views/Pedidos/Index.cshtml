@model IEnumerable<DSWI_T1_INDIVIDUAL02.Models.Pedido>

@{
    ViewData["Title"] = "Gestión de pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de pedidos</h2>
    <a asp-action="Crear" class="btn btn-primary">
        + Nuevo pedido
    </a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Cliente ID</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pedido in Model)
        {
            <tr>
                <td>@pedido.PedidoId</td>
                <td>@pedido.FechaPedido.ToString("dd/MM/yyyy")</td>
                <td>$ @pedido.Monto.ToString("N2")</td>
                <td>@pedido.Estado</td>
                <td>@pedido.ClienteId</td>
                <td>
                    <a asp-action="Editar"
                       asp-route-id="@pedido.PedidoId"
                       class="btn btn-sm btn-outline-primary">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
